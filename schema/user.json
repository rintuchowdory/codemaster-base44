{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "description": "Represents a user in the CodeMaster app",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (auto-generated by Base44)"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp (auto-generated)"
    },
    "updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp (auto-generated)"
    },
    "created_by": {
      "type": "string",
      "description": "ID of the user who created this record (auto-generated)"
    },
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": ["admin", "user"]
    }
  },
  "required": ["role"]
}
